{
    "name": "yiisoft/yii2-app-basic",
    "description": "Yii 2 Basic Project Template",
    "keywords": ["yii2", "framework", "basic", "project template"],
    "homepage": "https://www.yiiframework.com/",
    "type": "project",
    "license": "BSD-3-Clause",
    "support": {
        "issues": "https://github.com/yiisoft/yii2/issues?state=open",
        "forum": "https://www.yiiframework.com/forum/",
        "wiki": "https://www.yiiframework.com/wiki/",
        "irc": "irc://irc.freenode.net/yii",
        "source": "https://github.com/yiisoft/yii2"
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "yiisoft/yii2": "~2.0.45",
        "yiisoft/yii2-bootstrap5": "~2.0.2",
        "yiisoft/yii2-symfonymailer": "~2.0.3",
        "mihaildev/yii2-ckeditor": "^1.0",
        "mihaildev/yii2-elfinder": "^1.4",
        "himiklab/yii2-recaptcha-widget": "^2.1",
        "bower-asset/font-awesome": "^6.2",
        "kartik-v/yii2-widget-select2": "dev-master",
        "bower-asset/bootstrap": "^5.2",
        "yiisoft/yii2-imagine": "^2.3",
        "bower-asset/fancybox": "^3.5",
        "almasaeed2010/adminlte": "~3.2",
        "yiisoft/yii2-queue": "^2.3",
        "yiisoft/yii2-httpclient": "^2.0",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "ext-imagick": "*",
        "ext-curl": "*",
        "ext-exif": "*"
    },
    "require-dev": {
        "yiisoft/yii2-debug": "~2.1.0",
        "yiisoft/yii2-gii": "~2.2.0",
        "phpstan/phpstan": "^2.2",
        "erickskrauch/phpstan-yii2": "dev-master",
        "squizlabs/php_codesniffer": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.95",
        "qossmic/deptrac-shim": "^1.0",
        "vimeo/psalm": "^6.16",
        "phpro/grumphp": "^2.23"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "phpro/grumphp": true
        },
        "process-timeout": 1800,
        "fxp-asset": {
            "enabled": false
        },
        "platform": {
            "ext-imagick": "8.0.0"
        }
    },
    "scripts": {
        "php-stan": [
            "php vendor/bin/phpstan analyse -l 5"
        ],
        "php-cs-fixer diff": [
            "php vendor/bin/php-cs-fixer fix --dry-run --diff"
        ],
        "php-cs-fixer fix": [
            "php vendor/bin/php-cs-fixer fix"
        ],
        "deptrac": [
            "php vendor/bin/deptrac"
        ],
        "psalm": [
            "php vendor/bin/psalm"
        ],
        "post-install-cmd": [
            "yii\\composer\\Installer::postInstall"
        ],
        "post-create-project-cmd": [
            "yii\\composer\\Installer::postCreateProject",
            "yii\\composer\\Installer::postInstall"
        ]
    },
    "extra": {
        "yii\\composer\\Installer::postCreateProject": {
            "setPermission": [
                {
                    "runtime": "0777",
                    "web/assets": "0777",
                    "yii": "0755"
                }
            ]
        },
        "yii\\composer\\Installer::postInstall": {
            "generateCookieValidationKey": [
                "config/web.php"
            ]
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
